<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["BrandName"] ?? "Marketplace") — @(ViewData["Title"] ?? "Landing Page")</title>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="~/lib/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Lato&display=swap" rel="stylesheet">
    @if (ViewData["Brand"] != null && ViewData["Brand"].ToString() != "default")
    {
        <link rel="stylesheet" href="~/css/brand-shared.css" />
        <link rel="stylesheet" href="~/css/@(ViewData["Brand"]).css" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/customer-site.css" />
        <link rel="stylesheet" href="~/css/customer-custom.css" />
        <link href="~/lib/bootstrap/customer-offcanvas.css" rel="stylesheet" />
    }
</head>
<body class="@(ViewData["Brand"] != null && ViewData["Brand"].ToString() != "default" ? "brand-page" : "")">
    @if (ViewData["Brand"] != null && ViewData["Brand"].ToString() != "default")
    {
        <!-- Branded navbar -->
        <nav class="brand-navbar">
            <a class="brand-logo" href="@Url.Action("Index", "Home")">
                <img src="@Url.Content("~" + ViewData["BrandLogo"])" alt="@(ViewData["BrandName"])" />
            </a>
            <div class="nav-user">
                @if (this.User.Identity.IsAuthenticated)
                {
                    <span>@User.Identity.Name</span>
                    <a asp-controller="Account" asp-action="SignOut"><i class="fa fa-sign-out"></i> Sign out</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="SignIn">Sign in</a>
                }
            </div>
        </nav>
    }
    else
    {
        <!-- Default navbar (original) -->
        <nav class="navbar navbar-expand-lg fixed-top navbar-dark cm-top-nav-bar">
            <a class="navbar-brand mr-auto mr-lg-0" href="@Url.Action("Index", "Home")">
                <img class="cm-logo" style="padding-left:15px;" src="~/contoso-sales.png" />
            </a>
            <div class="navbar-collapse offcanvas-collapse" id="navbarsExampleDefault">
                <div class="navbar-nav mr-auto"></div>
                <div class="form-inline my-2 my-lg-0 ms-auto" style="padding-right:10px;">
                    @if (this.User.Identity.IsAuthenticated)
                    {
                        <span class="cm-username text-white">@User.Identity.Name&nbsp;</span>
                        <a class="text-white cm-logout" style="text-decoration: none;" asp-controller="Account" asp-action="SignOut">&nbsp;<i class="fa fa-sign-out fa-2x"></i></a>
                    }
                    else
                    {
                        <a class="text-white" style="text-decoration: none;" asp-controller="Account" asp-action="SignIn">Sign in</a>
                    }
                </div>
            </div>
        </nav>
        <div class="nav-scroller bg-white shadow-sm cm-menu-bar">
            <nav class="container pb-3 nav nav-underline">
                <a class="nav-link active">
                    @if (this.User.Identity.IsAuthenticated)
                    {
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        @if (TempData["ShowWelcomeScreen"] != null && Convert.ToString(TempData["ShowWelcomeScreen"]) == "True")
                        {
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Subscriptions">Subscriptions</a>
                        }
                    }
                </a>
            </nav>
        </div>
    }

    @if (ViewData["Brand"] != null && ViewData["Brand"].ToString() != "default")
    {
        <main role="main">
            @RenderBody()
        </main>
        <footer class="brand-footer">
            &copy; @DateTime.Now.Year @(ViewData["BrandName"]) &mdash;
            <a href="@(ViewData["BrandUrl"])" target="_blank">@(ViewData["BrandUrl"])</a>
        </footer>
    }
    else
    {
        <div class="container pb-3">
            <partial name="_CookieConsentPartial" />
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="cm-footer">
            <div class="container text-center">
                &copy; 2020 - SaasKit - Demo - Version: @ViewData["AppVersion"]
            </div>
        </footer>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/offcanvas.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
